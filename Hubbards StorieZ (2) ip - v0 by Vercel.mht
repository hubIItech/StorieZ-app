@charset "utf-8";

.fides-banner-button { white-space: nowrap; cursor: pointer; border: unset; border-radius: 128px; outline: none; height: 32px; padding: 0px 12px; transition: background 0.15s, border 0.15s; font-weight: 500 !important; }

.fides-banner-button-primary { background: var(--v0-gray-1000); color: var(--v0-background-100); }

.fides-banner-button-primary:hover { background: var(--v0-gray-900); }

.fides-banner-button-secondary, .fides-banner-button-tertiary { background: var(--v0-background-100); color: var(--v0-gray-1000); border: 1px solid var(--v0-alpha-400); }

.fides-banner-button-secondary:hover, .fides-banner-button-tertiary:hover { border-color: var(--v0-gray-300); background: var(--v0-gray-100); }

@keyframes modal-appear { 
  0% { opacity: 0; transform: translateY(20px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.fides-modal-container { z-index: 9999; visibility: visible; background: rgba(0, 0, 0, 0.4); justify-content: center; align-items: center; font-size: 14px; line-height: 150%; transition: opacity 0.2s; display: flex; position: fixed; inset: 0px; }

.fides-modal-container:focus-visible { outline: none; }

.fides-modal-container[aria-hidden="true"] { visibility: hidden; opacity: 0; display: none; }

.fides-modal-content { pointer-events: all; color: var(--v0-gray-1000); background: var(--v0-background-200); border-radius: 12px; flex-direction: column; gap: 24px; max-width: 600px; animation: 0.2s ease 0s 1 normal forwards running modal-appear; display: flex; position: relative; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.1) 0px 20px 25px -5px, rgba(0, 0, 0, 0.1) 0px 8px 10px -6px; }

.fides-modal-body { flex-direction: column; gap: 24px; display: flex; }

.fides-modal-header { display: none; }

.fides-modal-title { letter-spacing: -0.96px; font-size: 24px; font-weight: 600; line-height: 32px; }

.fides-modal-description { color: var(--v0-gray-1000); font-size: 16px; line-height: 24px; }

.fides-modal-title, .fides-modal-description, .fides-modal-notices { padding: 0px 24px; }

.fides-modal-title { padding-top: 24px; }

.fides-modal-notices { padding-bottom: 24px; }

.fides-modal-content #fides-button-group { background: var(--v0-background-100); padding: 16px; }

.fides-modal-button-group { width: 100%; }

.fides-modal-button-group button:nth-child(2) { margin-left: auto; }

.fides-modal-content p, .fides-modal-content h1 { margin: 0px; }

.fides-modal-button-group .fides-banner-button { border-radius: 6px; }

.fides-divider { display: none; }

.fides-modal-notices { --notices-border: 1px solid var(--v0-alpha-400); }

.fides-modal-notices > div { border: 1px solid var(--v0-alpha-400); border-radius: 6px; overflow: hidden; }

.fides-notice-toggle-trigger { cursor: pointer; width: 100%; padding: 12px 16px; }

.fides-toggle { padding-right: 16px; }

.fides-notice-toggle-title { border-bottom: var(--v0-gray-400); background: var(--v0-background-100); justify-content: space-between; align-items: center; font-size: 14px; font-weight: 500; transition: background 0.1s; display: flex; }

.fides-notice-toggle-title:hover { background: var(--v0-background-200); }

.fides-disclosure-visible, .fides-disclosure-hidden { color: var(--v0-gray-900); padding: 16px; }

.fides-disclosure-visible { border-bottom: var(--v0-gray-400); }

.fides-disclosure-hidden { display: none; }

.fides-notice-toggle:last-child .fides-disclosure-visible, .fides-notice-toggle:last-child:not(.fides-notice-toggle-expanded) .fides-notice-toggle-title { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

div#fides-banner-container { visibility: visible; z-index: 9998; pointer-events: auto; width: 100%; max-width: 420px; transition: transform 0.7s cubic-bezier(0.5, 0.25, 0.35, 1); position: fixed; bottom: 16px; left: 16px; transform: translateY(0px); }

div#fides-banner-container.fides-banner-bottom.fides-banner-hidden { visibility: hidden; transform: translateY(150%); }

#fides-banner-inner { color: var(--v0-gray-1000); background: var(--v0-background-100); border: 1px solid var(--v0-alpha-400); border-radius: 12px; flex-direction: column; max-width: 600px; padding: 16px; font-size: 14px; line-height: 150%; display: flex; position: relative; box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 6px -1px, rgba(0, 0, 0, 0.1) 0px 2px 4px -2px; }

#fides-banner-inner * { box-sizing: border-box; }

#fides-banner-heading { display: none !important; }

.fides-modal-footer { background: var(--v0-background-100); border-top: 1px solid var(--v0-alpha-400); width: 100%; padding-right: 16px; display: flex; }

.fides-modal-footer #fides-button-group { flex: 1 1 0%; }

.fides-privacy-policy { color: var(--v0-gray-1000); transition: color 0.15s; }

.fides-privacy-policy:hover { color: var(--v0-gray-900); }

.fides-banner-description { margin-bottom: 12px; }

.fides-close-button { position: absolute; top: 16px; right: 16px; display: none !important; }

#fides-button-group { flex-direction: row; justify-content: space-between; display: flex; }

#fides-button-group > div { flex-direction: row; gap: 12px; display: flex; }

#fides-button-group #fides-privacy-policy-link { display: none !important; }

@media (prefers-reduced-motion: reduce) {
  .fides-toggle-display { transition-duration: 0s; }
}

.fides-toggle { --diameter: 24px; --width: 40px; height: calc(var(--diameter) + 2px); position: relative; }

.fides-toggle .fides-toggle-input { cursor: pointer; opacity: 0; z-index: 4; width: 100%; height: 100%; position: absolute; }

.fides-toggle .fides-toggle-display { background-color: var(--v0-gray-100); border: 1px solid var(--v0-alpha-400); box-sizing: content-box; color: rgb(255, 255, 255); height: 24px; width: var(--width); border-radius: 128px; justify-content: space-around; align-items: center; font-size: 0px; transition: 0.2s; position: relative; display: inline-flex !important; }

.fides-toggle .fides-toggle-display::before { background: var(--v0-caveat-toggle-false); box-sizing: border-box; content: ""; height: var(--diameter); width: var(--diameter); z-index: 3; border-radius: 50%; transition: inherit; position: absolute; top: 50%; left: 0px; transform: translateY(-50%); box-shadow: rgba(0, 0, 0, 0.16) 0px 1px 1px, rgba(0, 0, 0, 0.12) 0px 0px 4px; }

.fides-toggle .fides-toggle-input:checked + .fides-toggle-display::before { background: rgb(255, 255, 255); }

.fides-toggle .fides-toggle-input:disabled + .fides-toggle-display::before { background: var(--v0-gray-200); }

