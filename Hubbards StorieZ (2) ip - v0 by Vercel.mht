@layer components {
  .geist-container { flex-direction: column; flex: var(--flex); justify-content: var(--justify-content); align-items: var(--align-items); min-width: 1px; max-width: 100%; display: flex; position: relative; }
  .geist-container.nowrap { flex-wrap: nowrap !important; }
  .geist-container.inline { display: inline-flex; }
