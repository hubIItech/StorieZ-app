.fides-toggle .fides-toggle-input:checked + .fides-toggle-display::before { transform: translate(calc(var(--width) - var(--diameter)), -50%); }

.fides-toggle .fides-toggle-input:disabled { cursor: not-allowed; }

.fides-toggle .fides-toggle-input:disabled + .fides-toggle-display { background: var(--v0-background-100); }

